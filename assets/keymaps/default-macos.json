[
  {
    "bindings": {
      "cmd-k": "studio::ToggleCommandPalette",
      "cmd-,": "studio::OpenSettings",
      "cmd-shift-b": "studio::SwitchBranch",
      "cmd-shift-n": "studio::NewWindow",
      "cmd-[": "studio::GoBack",
      "cmd-]": "studio::GoForward",
      "cmd-q": "studio::Quit"
    }
  },
  {
    "context": "Workspace && !TextInput",
    "bindings": {
      "?": "studio::ShowKeyBindings"
    }
  },
  {
    "bindings": {
      "cmd-shift-a": "studio_agent::OpenAgent"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "cmd-enter": "studio_agent::Send",
      "cmd-shift-.": "studio_agent::Stop",
      "cmd-y": "studio_agent::Allow",
      "cmd-alt-y": "studio_agent::AllowAlways",
      "cmd-alt-n": "studio_agent::Reject"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-1": ["studio::ActivateItem", { "index": 0 }],
      "cmd-2": ["studio::ActivateItem", { "index": 1 }],
      "cmd-3": ["studio::ActivateItem", { "index": 2 }],
      "cmd-4": ["studio::ActivateItem", { "index": 3 }],
      "cmd-5": ["studio::ActivateItem", { "index": 4 }],
      "cmd-6": ["studio::ActivateItem", { "index": 5 }],
      "cmd-7": ["studio::ActivateItem", { "index": 6 }],
      "cmd-8": ["studio::ActivateItem", { "index": 7 }],
      "cmd-9": "studio::ActivateLastItem"
    }
  }
]
