[
  {
    "bindings": {
      "cmd-k": "studio::ToggleCommandPalette",
      "cmd-,": "studio::OpenSettings",
      "cmd-shift-b": "studio::SwitchBranch",
      "cmd-shift-n": "studio::NewWindow",
      "cmd-[": "studio::GoBack",
      "cmd-]": "studio::GoForward",
      "cmd-q": "studio::Quit"
    }
  },
  {
    "context": "Workspace && !TextInput",
    "bindings": {
      "?": "studio::ShowKeyBindings"
    }
  }
]
