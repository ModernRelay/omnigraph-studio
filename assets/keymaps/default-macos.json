[
  {
    "bindings": {
      "cmd-shift-p": "studio::ToggleCommandPalette",
      "cmd-k": "studio::ToggleCommandPalette",
      "cmd-p": "studio::GoTo",
      "cmd-,": "studio::OpenSettings",
      "cmd-shift-b": "studio::SwitchBranch",
      "cmd-shift-n": "studio::NewWindow",
      "cmd-[": "studio::GoBack",
      "cmd-]": "studio::GoForward",
      "cmd-q": "studio::Quit",
      "cmd-alt-shift-f": "studio::ToggleFrameOverlay"
    }
  },
  {
    "context": "Workspace && !Editor",
    "bindings": {
      "?": "studio::ShowKeyBindings"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "shift-escape": "studio::ToggleZoom",
      "cmd-w": "studio::CloseActiveItem",
      "ctrl-tab": "studio::ActivateNextItem",
      "ctrl-shift-tab": "studio::ActivatePreviousItem",
      "cmd-shift-]": "studio::ActivateNextItem",
      "cmd-shift-[": "studio::ActivatePreviousItem",
      "cmd-b": "studio::ToggleSidebar",
      "cmd-alt-b": "studio::ToggleInspector",
      "cmd-j": "studio::ToggleActivity",
      "cmd-\\": "studio::SplitRight",
      "cmd-shift-\\": "studio::SplitDown",
      "cmd-alt-right": "studio::ActivateNextPane",
      "cmd-alt-left": "studio::ActivatePreviousPane",
      "ctrl-cmd-]": "studio::ActivateNextGraph",
      "ctrl-cmd-[": "studio::ActivatePreviousGraph",
      "cmd-o": [
        "studio_graph::OpenQueryFile",
        {}
      ]
    }
  },
  {
    "bindings": {
      "cmd-shift-a": "studio_agent::OpenAgent"
    }
  },
  {
    "context": "BlobView",
    "bindings": {
      "0": "studio_canvas::FitToWindow",
      "1": "studio_canvas::ActualSize",
      "=": "studio_canvas::ZoomIn",
      "+": "studio_canvas::ZoomIn",
      "-": "studio_canvas::ZoomOut",
      "cmd-0": "studio_canvas::FitToWindow",
      "cmd-=": "studio_canvas::ZoomIn",
      "cmd--": "studio_canvas::ZoomOut"
    }
  },
  {
    "context": "AgentComposer > Editor",
    "bindings": {
      "enter": "studio_agent::Send",
      "shift-enter": "editor::Newline",
      "cmd-shift-enter": "studio_agent::SendNow"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "cmd-enter": "studio_agent::Send",
      "cmd-shift-.": "studio_agent::Stop",
      "cmd-y": "studio_agent::Allow",
      "cmd-alt-y": "studio_agent::AllowAlways",
      "cmd-alt-n": "studio_agent::Reject"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-1": [
        "studio::ActivateItem",
        {
          "index": 0
        }
      ],
      "cmd-2": [
        "studio::ActivateItem",
        {
          "index": 1
        }
      ],
      "cmd-3": [
        "studio::ActivateItem",
        {
          "index": 2
        }
      ],
      "cmd-4": [
        "studio::ActivateItem",
        {
          "index": 3
        }
      ],
      "cmd-5": [
        "studio::ActivateItem",
        {
          "index": 4
        }
      ],
      "cmd-6": [
        "studio::ActivateItem",
        {
          "index": 5
        }
      ],
      "cmd-7": [
        "studio::ActivateItem",
        {
          "index": 6
        }
      ],
      "cmd-8": [
        "studio::ActivateItem",
        {
          "index": 7
        }
      ],
      "cmd-9": "studio::ActivateLastItem"
    }
  },
  {
    "bindings": {
      "cmd-n": "studio_graph::NewQuery",
      "cmd-shift-o": "studio_graph::OpenOntology",
      "cmd-shift-e": "studio_graph::OpenCanvas"
    }
  },
  {
    "context": "TypeTable && !editing",
    "bindings": {
      "j": "studio_table::MoveDown",
      "down": "studio_table::MoveDown",
      "k": "studio_table::MoveUp",
      "up": "studio_table::MoveUp",
      "left": "studio_table::MoveLeft",
      "right": "studio_table::MoveRight",
      "enter": "studio_table::EditCell",
      "space": "studio_table::PeekRow",
      "g": "studio_table::ExploreRow",
      "cmd-c": "studio_table::CopyCell",
      "cmd-backspace": "studio_table::DeleteRow",
      "cmd-alt-f": "studio_table::FilterBySelection"
    }
  },
  {
    "context": "FilterValue > Editor",
    "bindings": {
      "up": "studio_table::SelectPreviousSuggestion",
      "down": "studio_table::SelectNextSuggestion"
    }
  },
  {
    "context": "EdgeEndpoint > Editor",
    "bindings": {
      "up": "studio_table::SelectPreviousSuggestion",
      "down": "studio_table::SelectNextSuggestion"
    }
  },
  {
    "context": "TypeTable && editing",
    "bindings": {
      "enter": "studio_table::ConfirmEdit",
      "alt-enter": "studio_table::StageEdit"
    }
  },
  {
    "context": "TypeTable",
    "bindings": {
      "escape": "studio_table::Cancel",
      "cmd-s": "studio_table::SaveDrafts",
      "cmd-r": "studio_table::RefreshTable",
      "cmd-n": "studio_table::InsertRow",
      "cmd-f": "studio_table::AddFilter",
      "cmd-alt-backspace": "studio_table::ClearFilters"
    }
  },
  {
    "context": "Tree",
    "bindings": {
      "up": "studio_tree::SelectPrevious",
      "down": "studio_tree::SelectNext",
      "right": "studio_tree::Expand",
      "left": "studio_tree::Collapse",
      "enter": "studio_tree::OpenSelected",
      "alt-right": "studio_tree::ExpandAll",
      "alt-left": "studio_tree::CollapseAll",
      "cmd-enter": "studio_tree::OpenTable"
    }
  },
  {
    "context": "Tree && !filtering",
    "bindings": {
      "f": "studio_tree::RerootHere",
      "g": "studio_tree::ShowOnCanvas",
      "space": "studio_tree::PeekSelected",
      "h": "studio_tree::ToggleEmptyGroups"
    }
  },
  {
    "context": "Tree && filtering",
    "bindings": {
      "escape": "studio_tree::ClearFilter"
    }
  },
  {
    "context": "Canvas",
    "bindings": {
      "0": "studio_canvas::FitToWindow",
      "=": "studio_canvas::ZoomIn",
      "+": "studio_canvas::ZoomIn",
      "-": "studio_canvas::ZoomOut",
      "enter": "studio_canvas::ExpandNode",
      "backspace": "studio_canvas::CollapseNode",
      "left": "studio_canvas::MoveLeft",
      "right": "studio_canvas::MoveRight",
      "up": "studio_canvas::MoveUp",
      "down": "studio_canvas::MoveDown",
      "space": "studio_canvas::PeekSelected",
      "f": "studio_canvas::FocusSelected",
      "[": "studio_canvas::WalkBack",
      "]": "studio_canvas::WalkForward",
      "r": "studio_canvas::ResetLayout",
      "cmd-a": "studio_canvas::SelectAll",
      "escape": "studio_canvas::ClearSelection"
    }
  },
  {
    "context": "QueryEditor > Editor",
    "bindings": {
      "cmd-enter": "studio_query::Run",
      "cmd-shift-enter": "studio_query::Explain",
      "cmd-s": "studio_query::Save",
      "cmd-shift-s": "studio_query::SaveAs"
    }
  },
  {
    "context": "QueryEditor",
    "bindings": {
      "cmd-enter": "studio_query::Run",
      "cmd-shift-enter": "studio_query::Explain",
      "cmd-s": "studio_query::Save",
      "cmd-shift-s": "studio_query::SaveAs"
    }
  },
  {
    "context": "SettingsField",
    "bindings": {
      "enter": "menu::Confirm"
    }
  },
  {
    "context": "QueryConfirm",
    "bindings": {
      "enter": "menu::Confirm",
      "escape": "menu::Cancel"
    }
  },
  {
    "context": "QueryResults",
    "bindings": {
      "cmd-c": "studio_query::CopyCell",
      "cmd-shift-c": "studio_query::CopyRow"
    }
  },
  {
    "context": "Review && !searching",
    "bindings": {
      "enter": "studio_review::EditChange",
      "j": "studio_review::NextChange",
      "down": "studio_review::NextChange",
      "k": "studio_review::PreviousChange",
      "up": "studio_review::PreviousChange"
    }
  },
  {
    "context": "Review",
    "bindings": {
      "cmd-y": "studio_review::AcceptAndNext",
      "alt-cmd-z": "studio_review::RevertAndNext",
      "cmd-shift-enter": "studio_review::Merge"
    }
  },
  {
    "context": "History && !searching",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious"
    }
  },
  {
    "context": "History && searching",
    "bindings": {
      "enter": "studio_history::NextMatch",
      "shift-enter": "studio_history::PreviousMatch"
    }
  },
  {
    "context": "CommandPalette",
    "bindings": {
      "cmd-1": [
        "studio_palette::ShowScope",
        {
          "index": 0
        }
      ],
      "cmd-2": [
        "studio_palette::ShowScope",
        {
          "index": 1
        }
      ],
      "cmd-3": [
        "studio_palette::ShowScope",
        {
          "index": 2
        }
      ],
      "cmd-4": [
        "studio_palette::ShowScope",
        {
          "index": 3
        }
      ],
      "cmd-5": [
        "studio_palette::ShowScope",
        {
          "index": 4
        }
      ],
      "cmd-6": [
        "studio_palette::ShowScope",
        {
          "index": 5
        }
      ]
    }
  },
  {
    "context": "CommandPalette > Editor",
    "bindings": {
      "tab": "studio_palette::AskAgent"
    }
  }
]
