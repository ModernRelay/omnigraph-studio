[
  {
    "bindings": {
      "ctrl-shift-p": "studio::ToggleCommandPalette",
      "ctrl-k": "studio::ToggleCommandPalette",
      "ctrl-p": "studio::GoTo",
      "ctrl-,": "studio::OpenSettings",
      "ctrl-shift-b": "studio::SwitchBranch",
      "ctrl-shift-n": "studio::NewWindow",
      "alt-left": "studio::GoBack",
      "alt-right": "studio::GoForward",
      "ctrl-q": "studio::Quit"
    }
  },
  {
    "context": "Workspace && !TextInput",
    "bindings": {
      "?": "studio::ShowKeyBindings"
    }
  },
  {
    "bindings": {
      "ctrl-shift-a": "studio_agent::OpenAgent"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-enter": "studio_agent::Send",
      "ctrl-shift-.": "studio_agent::Stop",
      "ctrl-y": "studio_agent::Allow",
      "ctrl-alt-y": "studio_agent::AllowAlways",
      "ctrl-alt-n": "studio_agent::Reject"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-1": [
        "studio::ActivateItem",
        {
          "index": 0
        }
      ],
      "alt-2": [
        "studio::ActivateItem",
        {
          "index": 1
        }
      ],
      "alt-3": [
        "studio::ActivateItem",
        {
          "index": 2
        }
      ],
      "alt-4": [
        "studio::ActivateItem",
        {
          "index": 3
        }
      ],
      "alt-5": [
        "studio::ActivateItem",
        {
          "index": 4
        }
      ],
      "alt-6": [
        "studio::ActivateItem",
        {
          "index": 5
        }
      ],
      "alt-7": [
        "studio::ActivateItem",
        {
          "index": 6
        }
      ],
      "alt-8": [
        "studio::ActivateItem",
        {
          "index": 7
        }
      ],
      "alt-9": "studio::ActivateLastItem"
    }
  },
  {
    "bindings": {
      "ctrl-n": "studio_graph::NewQuery"
    }
  },
  {
    "context": "TypeTable && !editing",
    "bindings": {
      "j": "studio_table::MoveDown",
      "down": "studio_table::MoveDown",
      "k": "studio_table::MoveUp",
      "up": "studio_table::MoveUp",
      "left": "studio_table::MoveLeft",
      "right": "studio_table::MoveRight",
      "enter": "studio_table::EditCell",
      "space": "studio_table::PeekRow",
      "ctrl-c": "studio_table::CopyCell",
      "ctrl-backspace": "studio_table::DeleteRow",
      "ctrl-alt-f": "studio_table::FilterBySelection"
    }
  },
  {
    "context": "TypeTable && editing",
    "bindings": {
      "enter": "studio_table::ConfirmEdit"
    }
  },
  {
    "context": "TypeTable",
    "bindings": {
      "escape": "studio_table::Cancel",
      "ctrl-r": "studio_table::RefreshTable",
      "ctrl-n": "studio_table::InsertRow",
      "ctrl-f": "studio_table::AddFilter",
      "ctrl-alt-backspace": "studio_table::ClearFilters"
    }
  },
  {
    "context": "Tree",
    "bindings": {
      "up": "studio_tree::SelectPrevious",
      "down": "studio_tree::SelectNext",
      "right": "studio_tree::Expand",
      "left": "studio_tree::Collapse",
      "enter": "studio_tree::OpenSelected",
      "alt-right": "studio_tree::ExpandAll",
      "alt-left": "studio_tree::CollapseAll",
      "ctrl-enter": "studio_tree::OpenTable"
    }
  },
  {
    "context": "Tree && !filtering",
    "bindings": {
      "f": "studio_tree::RerootHere",
      "g": "studio_tree::ShowOnCanvas",
      "space": "studio_tree::PeekSelected",
      "h": "studio_tree::ToggleEmptyGroups"
    }
  },
  {
    "context": "Tree && filtering",
    "bindings": {
      "escape": "studio_tree::ClearFilter"
    }
  },
  {
    "context": "Canvas",
    "bindings": {
      "0": "studio_canvas::FitToWindow",
      "=": "studio_canvas::ZoomIn",
      "+": "studio_canvas::ZoomIn",
      "-": "studio_canvas::ZoomOut",
      "enter": "studio_canvas::ExpandNode",
      "backspace": "studio_canvas::CollapseNode",
      "left": "studio_canvas::MoveLeft",
      "right": "studio_canvas::MoveRight",
      "up": "studio_canvas::MoveUp",
      "down": "studio_canvas::MoveDown"
    }
  },
  {
    "context": "QueryEditor > Editor",
    "bindings": {
      "ctrl-enter": "studio_query::Run",
      "ctrl-shift-enter": "studio_query::Explain"
    }
  },
  {
    "context": "QueryEditor",
    "bindings": {
      "ctrl-enter": "studio_query::Run",
      "ctrl-shift-enter": "studio_query::Explain"
    }
  },
  {
    "context": "QueryConfirm",
    "bindings": {
      "enter": "menu::Confirm",
      "escape": "menu::Cancel"
    }
  },
  {
    "context": "QueryResults",
    "bindings": {
      "ctrl-c": "studio_query::CopyCell",
      "ctrl-shift-c": "studio_query::CopyRow"
    }
  },
  {
    "context": "Review && !searching",
    "bindings": {
      "enter": "studio_review::EditChange",
      "j": "studio_review::NextChange",
      "down": "studio_review::NextChange",
      "k": "studio_review::PreviousChange",
      "up": "studio_review::PreviousChange"
    }
  },
  {
    "context": "Review",
    "bindings": {
      "ctrl-y": "studio_review::AcceptAndNext",
      "alt-ctrl-z": "studio_review::RevertAndNext",
      "ctrl-shift-enter": "studio_review::Merge"
    }
  },
  {
    "context": "History && !searching",
    "bindings": {
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious"
    }
  },
  {
    "context": "History && searching",
    "bindings": {
      "enter": "studio_history::NextMatch",
      "shift-enter": "studio_history::PreviousMatch"
    }
  }
]
