#!/usr/bin/env bash
# Build a Linux tarball of OmniGraph Studio in target/bundle (spec 001, "Shipping"):
#
#   omnigraph-studio-<version>-linux-<arch>/
#     bin/omnigraph-studio
#     share/applications/omnigraph-studio.desktop
#     share/icons/hicolor/512x512/apps/omnigraph-studio.png
#     LICENSE
#     THIRD-PARTY-NOTICES.md
#
#   script/bundle-linux            # release build
#   script/bundle-linux --debug    # the debug build, to check the layout quickly
#
# Unpack anywhere and run bin/omnigraph-studio; copy share/ into ~/.local/share to list it,
# with its icon, in a launcher. An AppImage is not built yet.
#
# A release runs on glibc 2.35 (`GLIBC_FLOOR`: Ubuntu 22.04, Debian 12) and later, so it is built
# on Ubuntu 22.04: a binary that needs a newer glibc is refused here rather than shipped.
set -euo pipefail

GLIBC_FLOOR=2.35

ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"

profile=release
case "${1:-}" in
  --debug) profile=debug ;;
  "") ;;
  *) echo "usage: script/bundle-linux [--debug]" >&2; exit 2 ;;
esac

if [[ "$(uname)" != "Linux" ]]; then
  echo "bundle-linux runs on Linux" >&2
  exit 1
fi

version=$(python3 -c 'import tomllib; print(tomllib.load(open("Cargo.toml", "rb"))["workspace"]["package"]["version"])')
arch=$(uname -m)
name="omnigraph-studio-$version-linux-$arch"

if [[ "$profile" == release ]]; then
  cargo build --locked --release -p studio --bin omnigraph-studio
  needed=$(objdump -T target/release/omnigraph-studio | grep -o 'GLIBC_[0-9.]*' |
    sed 's/GLIBC_//' | sort -t. -k1,1n -k2,2n | tail -1)
  if [[ "$(printf '%s\n%s\n' "$GLIBC_FLOOR" "$needed" | sort -t. -k1,1n -k2,2n | tail -1)" != "$GLIBC_FLOOR" ]]; then
    echo "bundle-linux: the build needs glibc $needed, newer than $GLIBC_FLOOR; build on Ubuntu 22.04" >&2
    exit 1
  fi
else
  cargo build --locked -p studio --bin omnigraph-studio
fi

out="$ROOT/target/bundle"
staging=$(mktemp -d)
trap 'rm -rf "$staging"' EXIT
dir="$staging/$name"
mkdir -p "$dir/bin" "$dir/share/applications" "$dir/share/icons/hicolor/512x512/apps"
cp "target/$profile/omnigraph-studio" "$dir/bin/omnigraph-studio"
cp resources/linux/omnigraph-studio.desktop.in "$dir/share/applications/omnigraph-studio.desktop"
# The icon the .desktop entry names (script/make-icon.py draws it).
cp resources/linux/omnigraph-studio.png "$dir/share/icons/hicolor/512x512/apps/omnigraph-studio.png"
cp LICENSE "$dir/"
# Third-party notices (script/generate-licenses): a release needs them; a debug bundle has them
# when cargo-about is installed.
if [[ "$profile" == release ]] || cargo about --version >/dev/null 2>&1; then
  script/generate-licenses "$dir/THIRD-PARTY-NOTICES.md" >/dev/null
fi

mkdir -p "$out"
tar -czf "$out/$name.tar.gz" -C "$staging" "$name"
echo "$out/$name.tar.gz"
