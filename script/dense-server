#!/usr/bin/env bash
# Serve the dense measuring graph (script/dense-graph.py, schema script/dense-graph.pg) as the
# graph `dense` on http://127.0.0.1:8788, with token `dev-token` (actor `act-dev`, allowed
# everything by dev/cluster's policies). Point Studio or the snapshot example at it with
# OMNIGRAPH_STUDIO_SERVER=http://127.0.0.1:8788 OMNIGRAPH_STUDIO_TOKEN=dev-token
# OMNIGRAPH_STUDIO_GRAPH=dense.
#
#   script/dense-server            # first run applies the cluster and loads the generated rows
#   script/dense-server --reset    # start again from an empty data directory
#
# Data lives in DENSE_DATA (default dev/.dense-data); DENSE_BIND changes the address.
# Needs Omnigraph's `omnigraph` and `omnigraph-server` speaking HTTP contract 0.14, on PATH or
# named by OMNIGRAPH_BIN and OMNIGRAPH_SERVER_BIN. script/dev-server explains the lock handling
# this script shortens.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DATA=${DENSE_DATA:-$ROOT/dev/.dense-data}
BIND=${DENSE_BIND:-127.0.0.1:8788}
CLI=${OMNIGRAPH_BIN:-omnigraph}
SERVER=${OMNIGRAPH_SERVER_BIN:-omnigraph-server}
TOKEN=dev-token

if [[ "${1:-}" == "--reset" ]]; then
  rm -rf "$DATA"
fi

contract=$("$CLI" version --json | python3 -c 'import json,sys; print(json.load(sys.stdin).get("http_contract"))')
if [[ "$contract" != 0.14 ]]; then
  echo "dense-server: $CLI speaks HTTP contract $contract, not 0.14 (set OMNIGRAPH_BIN)" >&2
  exit 1
fi
if curl -s -o /dev/null --max-time 2 "http://$BIND/healthz"; then
  echo "dense-server: something already answers at http://$BIND" >&2
  exit 1
fi

# An operator home of its own whose one target is the data directory as a direct root.
home=$(mktemp -d)
trap 'rm -rf "$home"' EXIT
mkdir -p "$DATA"
uri=$(python3 -c 'import json, pathlib, sys; print(json.dumps(pathlib.Path(sys.argv[1]).resolve().as_uri()))' "$DATA")
printf 'version: 1\ntargets:\n  dense: {kind: direct, scope: root, uri: %s}\n' "$uri" > "$home/config.yaml"
og() { OMNIGRAPH_HOME=$home "$CLI" "$@"; }
quietly() {
  local out
  if ! out=$(og "$@" 2>&1); then
    printf '%s\n' "$out" >&2
    echo "dense-server: omnigraph $* failed; its output is above" >&2
    exit 1
  fi
}
# A direct apply or load keeps the cluster lock; nothing else uses this directory, so a lock
# whose process is gone is released.
release_exited_lock() {
  local lock pid
  [[ -f "$DATA/__cluster/lock.json" ]] || return 0
  read -r lock pid < <(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["lock_id"], d.get("pid", ""))' "$DATA/__cluster/lock.json")
  if [[ -n "$pid" ]] && ! kill -0 "$pid" 2> /dev/null; then
    quietly cluster force-unlock "$lock" --target dense
  fi
}

pending="$DATA/.seed-pending"
if [[ ! -d "$DATA/__cluster" ]]; then
  touch "$pending"
  cp "$ROOT/script/dense-graph.pg" "$DATA/dense.pg"
  cp "$ROOT/dev/cluster/graph.policy.yaml" "$ROOT/dev/cluster/server.policy.yaml" "$DATA/"
  cat > "$DATA/cluster.yaml" <<'EOF'
version: 1
metadata:
  name: studio-dense
graphs:
  dense:
    schema: dense.pg
policies:
  graph-access:
    file: graph.policy.yaml
    applies_to: [dense]
  server-access:
    file: server.policy.yaml
    applies_to: [cluster]
EOF
  quietly cluster apply --config "$DATA" --target dense
fi
release_exited_lock

if [[ -f "$pending" ]]; then
  python3 "$ROOT/script/dense-graph.py" > "$DATA/dense.jsonl"
  quietly load --target dense --graph dense --data "$DATA/dense.jsonl" --mode overwrite
  release_exited_lock
  rm -f "$pending"
  echo "Loaded $(wc -l < "$DATA/dense.jsonl") rows into dense."
fi

OMNIGRAPH_SERVER_BEARER_TOKENS_JSON="{\"act-dev\":\"$TOKEN\"}" \
  "$SERVER" --cluster "$DATA" --bind "$BIND" &
server=$!
trap 'kill "$server" 2>/dev/null || true; wait "$server" 2>/dev/null || true; rm -rf "$home"' EXIT

for _ in $(seq 1 120); do
  kill -0 "$server" 2> /dev/null || { echo "dense-server: $SERVER exited before serving" >&2; exit 1; }
  curl -fsS "http://$BIND/readyz" > /dev/null 2>&1 && break
  sleep 0.5
done
served=$(curl -fsS -o /dev/null -D - "http://$BIND/healthz" | tr -d '\r' \
  | awk -F': *' 'tolower($1) == "omnigraph-http-api" { print $2 }')
if [[ "$served" != 0.14 ]]; then
  echo "dense-server: $SERVER answers contract '${served}' at /healthz, not 0.14 (set OMNIGRAPH_SERVER_BIN)" >&2
  exit 1
fi

echo "Serving http://$BIND · graph dense · token $TOKEN (actor act-dev) · server pid $server"
wait $server
