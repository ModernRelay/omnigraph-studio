#!/usr/bin/env bash
# Serve Studio's development graphs on http://127.0.0.1:8787 (`knowledge`, and a small `notes`
# graph for trying more than one graph in a window).
# Token `dev-token` resolves to actor `act-dev`, which the dev policy allows to do everything.
# Studio reaches it as its environment server (OMNIGRAPH_STUDIO_SERVER, OMNIGRAPH_STUDIO_TOKEN).
#
#   script/dev-server            # first run applies the cluster and loads dev/seed.jsonl
#   script/dev-server --reset    # start again from an empty graph
#
# Needs Omnigraph's `omnigraph` and `omnigraph-server` of `v0.14.0` or later, on PATH or named by
# OMNIGRAPH_BIN and OMNIGRAPH_SERVER_BIN. Both are checked: the CLI by its `version --json`, the
# started server by the contract header its /healthz answers with.
# Data lives in dev/.data; 0.14 stamps it format 16 on its first write, which 0.13 cannot open.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
DATA=${STUDIO_DEV_DATA:-$ROOT/dev/.data}
BIND=${STUDIO_DEV_BIND:-127.0.0.1:8787}
CLI=${OMNIGRAPH_BIN:-omnigraph}
SERVER=${OMNIGRAPH_SERVER_BIN:-omnigraph-server}
TOKEN=dev-token
NEEDS_CLI="dev-server needs an Omnigraph CLI of v0.14.0 or later, as Studio does"

if [[ "${1:-}" == "--reset" ]]; then
  rm -rf "$DATA"
fi

# The whole output, then its first line: with `| head -1` the CLI can panic writing its second
# line into a closed pipe, which `pipefail` turns into a failed start.
version=$("$CLI" version)
version=${version%%$'\n'*}
# The contract and the protocols Studio requires of a CLI (`PROTOCOLS` and `PROTOCOL` in
# crates/graph_store/src/cli_tokens.rs). Prints why the CLI is not one, or nothing.
# shellcheck disable=SC2016 # the backticks are the message's, not a command
unfit=$("$CLI" version --json 2> /dev/null | python3 -c '
import json, sys
try:
    facts = json.load(sys.stdin)
except ValueError:
    facts = None
if not isinstance(facts, dict):
    print("answers no `version --json`")
    sys.exit()
if facts.get("http_contract") != "0.14":
    print("speaks HTTP contract %s" % facts.get("http_contract"))
    sys.exit()
protocols = facts.get("protocols") or {}
for name in ("target", "credential", "access"):
    number = protocols.get(name)
    if number is None:
        print("reports no %s protocol" % name)
        sys.exit()
    if type(number) is not int or number != 2:
        print("reports %s protocol %s, which Studio does not drive" % (name, number))
        sys.exit()
' || true)
if [[ -n "$unfit" ]]; then
  echo "$NEEDS_CLI; $version $unfit (set OMNIGRAPH_BIN)" >&2
  exit 1
fi

# Something already answering at the address would be asked in this server's place, and this
# server would exit, unable to bind it. Asked before anything is written, so a first run on a
# busy address leaves no cluster behind.
if curl -s -o /dev/null --max-time 2 "http://$BIND/healthz"; then
  echo "dev-server: something already answers at http://$BIND; stop it, or set STUDIO_DEV_BIND to another address" >&2
  exit 1
fi

# The CLI runs in an operator home of its own, so the person's ~/.omnigraph and credentials take
# no part: a version-1 operator file whose one target, `dev`, is the data directory as a direct
# root, which a direct target names by an absolute file:// URI. The seeds are loaded through it
# before the server starts; a direct target needs no token.
home=$(mktemp -d)
trap 'rm -rf "$home"' EXIT
uri=$(python3 -c 'import json, pathlib, sys; print(json.dumps(pathlib.Path(sys.argv[1]).resolve().as_uri()))' "$DATA")
printf 'version: 1\ntargets:\n  dev: {kind: direct, scope: root, uri: %s}\n' "$uri" > "$home/config.yaml"
og() { OMNIGRAPH_HOME=$home "$CLI" "$@"; }

# Runs the CLI with its output kept, shown only when it fails: the target line it prints, and its
# advice on the lock it keeps, are this script's to act on.
quietly() {
  local out
  if ! out=$(og "$@" 2>&1); then
    printf '%s\n' "$out" >&2
    echo "dev-server: omnigraph $* failed; its output is above" >&2
    exit 1
  fi
}

# A direct apply or load keeps the cluster lock when it ends, and a server stopped without
# shutting down (killed, or its shell closed) leaves its own behind. Nothing else uses this
# directory, so a lock whose process is gone is released; a live one means another server is
# running. Says so unless asked to be quiet.
release_exited_lock() {
  local lock pid
  [[ -f "$DATA/__cluster/lock.json" ]] || return 0
  read -r lock pid < <(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print(d["lock_id"], d.get("pid", ""))' "$DATA/__cluster/lock.json")
  if [[ -n "$pid" ]] && ! kill -0 "$pid" 2> /dev/null; then
    quietly cluster force-unlock "$lock" --target dev
    if [[ "${1:-}" != quiet ]]; then
      echo "Released the cluster lock of a process that is gone (pid $pid)." >&2
    fi
  fi
}

# The seeds are loaded once, after the first apply. The marker stands from the apply until both
# loads are done, so a run that stops between them (a load that failed, the script stopped)
# seeds at the next run instead of serving empty graphs for good. A data directory from before
# the marker existed is taken as seeded.
pending="$DATA/.seed-pending"
if [[ ! -d "$DATA/__cluster" ]]; then
  mkdir -p "$DATA"
  touch "$pending"
  cp "$ROOT"/dev/cluster/*.yaml "$ROOT"/dev/cluster/*.pg "$DATA"/
  quietly cluster apply --config "$DATA" --target dev
  release_exited_lock quiet
fi
release_exited_lock

if [[ -f "$pending" ]]; then
  [[ -f "$ROOT/dev/seed.jsonl" ]] || python3 "$ROOT/script/dev-seed.py" > "$ROOT/dev/seed.jsonl"
  quietly load --target dev --graph knowledge --data "$ROOT/dev/seed.jsonl" --mode overwrite
  release_exited_lock quiet
  quietly load --target dev --graph notes --data "$ROOT/dev/notes-seed.jsonl" --mode overwrite
  release_exited_lock quiet
  rm -f "$pending"
  echo "Loaded dev/seed.jsonl into knowledge and dev/notes-seed.jsonl into notes."
fi

OMNIGRAPH_SERVER_BEARER_TOKENS_JSON="{\"act-dev\":\"$TOKEN\"}" \
  "$SERVER" --cluster "$DATA" --bind "$BIND" &
server=$!
# Only EXIT: bash runs it when a signal ends the script too, and a trapped INT or TERM would let the
# script carry on after the server is gone. The wait lets the server shut down and release the
# cluster lock before the script ends. Under `set -e` a failing command would end the trap, so a
# server already gone, or one a signal ended, still leaves its home removed.
trap 'kill "$server" 2>/dev/null || true; wait "$server" 2>/dev/null || true; rm -rf "$home"' EXIT

# Asked only while the server runs: one that exited (the address taken meanwhile, a cluster it
# cannot open) is reported as having exited, not as a server that answers no contract.
ready=0
for _ in $(seq 1 60); do
  if ! kill -0 "$server" 2>/dev/null; then break; fi
  if curl -fsS "http://$BIND/readyz" > /dev/null 2>&1; then ready=1; break; fi
  sleep 0.5
done
if ! kill -0 "$server" 2>/dev/null; then
  status=0
  wait "$server" || status=$?
  echo "dev-server: $SERVER exited (status $status) before it served http://$BIND; its output is above (is the address in use?)" >&2
  exit 1
fi
if [[ $ready == 0 ]]; then
  echo "dev-server: $SERVER did not answer http://$BIND/readyz within 30 s" >&2
  exit 1
fi

# The CLI's contract says nothing of the server's: a stale OMNIGRAPH_SERVER_BIN starts, and Studio
# would refuse it only once it connects. Ask the server itself, as Studio does, by the contract
# header its /healthz answers with.
served=$(curl -fsS -o /dev/null -D - "http://$BIND/healthz" 2> /dev/null \
  | tr -d '\r' | awk -F': *' 'tolower($1) == "omnigraph-http-api" { print $2 }' || true)
if [[ "$served" != 0.14 ]]; then
  if [[ -n "$served" ]]; then answer="contract $served"; else answer="no contract"; fi
  echo "dev-server needs an omnigraph-server of v0.14.0 or later, which speaks HTTP contract 0.14; $SERVER answers $answer at http://$BIND/healthz (set OMNIGRAPH_SERVER_BIN)" >&2
  exit 1
fi

echo "Serving http://$BIND · graphs knowledge, notes · token $TOKEN (actor act-dev)"
wait $server
