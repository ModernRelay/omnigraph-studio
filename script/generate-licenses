#!/usr/bin/env bash
# Writes the third-party notices Studio ships beside its own LICENSE (spec 001, "Shipping"):
# the licences of the fonts, icons and themes Studio embeds from Zed's assets, then every crate
# linked into the app, from cargo-about. It accepts the licences deny.toml allows, so cargo-deny
# stays the one place that says which licences Studio may use; a crate whose licence cannot be
# read fails the run.
#
#   script/generate-licenses [OUTPUT]   # default target/licenses/THIRD-PARTY-NOTICES.md
set -euo pipefail

CARGO_ABOUT_VERSION=0.9.2

ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
out=${1:-target/licenses/THIRD-PARTY-NOTICES.md}

if ! cargo about --version 2>/dev/null | grep -qx "cargo-about $CARGO_ABOUT_VERSION"; then
  echo "generate-licenses needs cargo-about $CARGO_ABOUT_VERSION:" \
    "cargo install --locked cargo-about@$CARGO_ABOUT_VERSION" >&2
  exit 1
fi

# Zed's checkout at the pinned tag, which its assets crate embeds from.
zed=$(cargo metadata --format-version 1 --locked | python3 -c '
import json, os, sys
packages = json.load(sys.stdin)["packages"]
assets = [p for p in packages
          if p["name"] == "assets" and "zed-industries/zed" in (p.get("source") or "")]
print(os.path.dirname(os.path.dirname(os.path.dirname(assets[0]["manifest_path"]))))
')

config=$(mktemp "${TMPDIR:-/tmp}/studio-about.XXXXXX")
trap 'rm -f "$config"' EXIT
python3 - deny.toml > "$config" <<'PY'
import sys, tomllib
licenses = tomllib.load(open(sys.argv[1], "rb"))["licenses"]
accepted = list(licenses["allow"])
for exception in licenses.get("exceptions", []):
    accepted += [name for name in exception["allow"] if name not in accepted]
print("accepted = [" + ", ".join(f'"{name}"' for name in accepted) + "]")
PY
cat script/licenses/about.toml >> "$config"

mkdir -p "$(dirname "$out")"
{
  echo "# Third-party notices"
  echo
  echo "OmniGraph Studio is free software under the GNU General Public License, version 3 or"
  echo "later (LICENSE). It includes the works below, each under its own licence."
  echo
  echo "## Fonts, icons and themes from Zed"
  for file in fonts/ibm-plex-sans/license.txt fonts/lilex/OFL.txt icons/LICENSES themes/LICENSES; do
    echo
    echo "### assets/$file"
    echo
    echo '```'
    cat "$zed/assets/$file"
    echo '```'
  done
  echo
  echo "## Themes Studio bundles"
  echo
  echo '```'
  cat assets/themes/LICENSES
  echo '```'
  echo
  echo "## Fonts Studio bundles"
  echo
  echo "Inter (assets/fonts/inter), Studio's default interface font:"
  echo
  echo '```'
  cat assets/fonts/inter/OFL.txt
  echo '```'
  echo
  echo "## Icons Studio bundles"
  echo
  echo "Studio's icons (assets/icons/nucleo) are Nucleo's, under Nucleo's licence, not the GPL."
  echo
  echo '```'
  cat assets/icons/nucleo/NOTICE
  echo '```'
  echo
  cargo about generate --locked --fail -c "$config" \
    --manifest-path crates/studio/Cargo.toml script/licenses/template.md.hbs
} > "$out"
echo "$out"
