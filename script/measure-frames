#!/usr/bin/env bash
# Measure the frames that matter most against the development graph, on the release-fast
# profile: a key in each kind of field and a table scroll (docs/drawing.md). Prints the main
# thread's CPU time per frame, median, p95 and mean (the mean still reads where the thread clock
# ticks coarsely, as gVisor's does in 10 ms), which a busy machine moves far less than wall
# time, and its allocations per frame, median, which are exact: the same count for the same
# frame on any machine. Compare times only between runs made in the same session.
#
#   script/dev-server &        # once, in another shell
#   script/measure-frames      # prints one line per case
#   script/measure-frames 2    # each case twice
#
# `--reads` measures reads instead of frames (spec 030): a Person table, a person's page, a
# commit by another writer to that person, seen by the head poll (up to 30 s), and the page's
# Refresh. After each step it prints the step's reads by answer from the session's ledger, the
# time to the first answer and to settled, and writes them all as JSON. Requests go through
# script/latency-proxy.py, which holds each one STUDIO_READS_LATENCY_MS (default 700, the
# personal graph's median; 0 sends them straight to the server). It writes to the development
# graph: a new title for person-000001.
#
#   script/measure-frames --reads before.json              # on one build
#   script/measure-frames --reads after.json               # on another
#   script/measure-frames --reads before.json after.json   # compares the two
#
# Needs the snapshot tool's build; it builds it first.
set -euo pipefail

if [[ "${1:-}" == "--reads" && $# -eq 3 ]]; then
  exec python3 "$(dirname "$0")/compare-reads.py" "$2" "$3"
fi

ROOT=$(cd "$(dirname "$0")/.." && pwd)
ROUNDS=${1:-1}
FRAMES=${STUDIO_MEASURE_FRAMES:-200}
OUT=$(mktemp -d)
trap 'rm -rf "$OUT"' EXIT
# Studio lists the person's CLI targets beside the server it is given, and a toast for each one it
# cannot reach is drawn in every frame measured (180 allocations a frame on one machine). Each case
# runs with an empty operator home instead, so it measures the development graph alone.
export OMNIGRAPH_HOME="$OUT/omnigraph-home"
mkdir -p "$OMNIGRAPH_HOME"

export OMNIGRAPH_STUDIO_SERVER=${OMNIGRAPH_STUDIO_SERVER:-http://127.0.0.1:8787}
export OMNIGRAPH_STUDIO_TOKEN=${OMNIGRAPH_STUDIO_TOKEN:-dev-token}
export OMNIGRAPH_STUDIO_GRAPH=${OMNIGRAPH_STUDIO_GRAPH:-knowledge}
export SNAPSHOT_WAIT_MS=${SNAPSHOT_WAIT_MS:-2000}

if ! curl -sf -o /dev/null "$OMNIGRAPH_STUDIO_SERVER/healthz"; then
  echo "no server at $OMNIGRAPH_STUDIO_SERVER; start script/dev-server first" >&2
  exit 1
fi

cargo build --quiet --profile release-fast -p studio --example snapshot --manifest-path "$ROOT/Cargo.toml"
SNAPSHOT="${CARGO_TARGET_DIR:-$ROOT/target}/release-fast/examples/snapshot"

PERSON='studio_graph::OpenType={"type_name":"Person"}'
PAGE='studio_graph::OpenNodePage={"type_name":"Person","id":"person-000001"}'

if [[ "${1:-}" == "--reads" ]]; then
  if [[ $# -ne 2 ]]; then
    echo "usage: script/measure-frames --reads <out.json> [<after.json>]" >&2
    exit 2
  fi
  export STUDIO_READS_LATENCY_MS=${STUDIO_READS_LATENCY_MS:-700}
  server=$OMNIGRAPH_STUDIO_SERVER
  if [[ $STUDIO_READS_LATENCY_MS != 0 ]]; then
    python3 "$ROOT/script/latency-proxy.py" "$server" --delay-ms "$STUDIO_READS_LATENCY_MS" > "$OUT/proxy" &
    proxy=$!
    trap 'kill "$proxy" 2>/dev/null || true; rm -rf "$OUT"' EXIT
    for _ in $(seq 1 50); do
      if [[ -s "$OUT/proxy" ]]; then break; fi
      sleep 0.1
    done
    OMNIGRAPH_STUDIO_SERVER=$(head -1 "$OUT/proxy")
  fi
  # The other writer: a new title for the person whose page is open, sent straight to the server.
  python3 -c 'import json, sys, time
query = "query scenario_write($t: String) { update Person set { title: $t } where slug = \"person-000001\" }"
json.dump({"query": query, "params": {"t": "Title %d" % time.time()}}, sys.stdout)' > "$OUT/write.json"
  cat > "$OUT/write" <<EOF
#!/bin/sh
exec curl -sf -o /dev/null -X POST '$server/graphs/$OMNIGRAPH_STUDIO_GRAPH/mutate' \
  -H 'Authorization: Bearer $OMNIGRAPH_STUDIO_TOKEN' -H 'Content-Type: application/json' \
  -H 'Omnigraph-Http-Api: 0.14' --data @'$OUT/write.json'
EOF
  chmod +x "$OUT/write"
  # The page's "Newer data · Refresh" is at (523, 210) in the default 1440x900 window.
  "$SNAPSHOT" "$OUT/frame.png" "reads:$2" "$PERSON" "$PAGE" "run:$OUT/write" head:60000 \
    click:523,210 2>&1 | grep -v '^snapshot data\|frame\.png$'
  exit "${PIPESTATUS[0]}"
fi

QUERY='query people() { match { $p: Person } return { $p.slug, $p.name, $p.title, $p.email, $p.born, $p.tags } }'
NEW_QUERY="studio_graph::NewQueryWithText={\"text\":\"$QUERY\"}"
# A company with its people, in the inspector, scrolled with the pointer over the dock.
INSPECTOR='studio_graph::PeekNode={"type_name":"Company","id":"company-00009"}'

# name, then the snapshot steps. "window redraw" draws every view again, as a frame of an
# animation (a dialog coming up, a toast, the connection dot) does: the cost of motion.
cases=(
  "table filter key|$PERSON|studio_table::AddFilter|measure:$FRAMES,type"
  "table cell key|$PERSON|studio_table::EditCell|key:right|studio_table::EditCell|measure:$FRAMES,type"
  "table scroll|$PERSON|measure:$FRAMES,scroll=40"
  "query key (6 columns)|$NEW_QUERY|studio_query::Run|measure:$FRAMES,type"
  "palette key|$PERSON|studio::GoTo|measure:$FRAMES,type"
  "window redraw|$PERSON|measure:$FRAMES,refresh"
  "node page scroll|$PAGE|measure:$FRAMES,scroll=40"
  "inspector scroll|studio_graph::OpenType={\"type_name\":\"Company\"}|$INSPECTOR|measure:$FRAMES,scroll=40,at=1270:500"
  "tree scroll|$PAGE|studio_graph::OpenAsTree|measure:$FRAMES,scroll=40"
  "canvas pan|$PAGE|studio_graph::OpenAsCanvas|measure:$FRAMES,drag=4:2"
  "canvas zoom|$PAGE|studio_graph::OpenAsCanvas|measure:$FRAMES,scroll=40"
  "history scroll|studio_graph::OpenHistory|measure:$FRAMES,scroll=40"
)

printf '%-24s %10s %10s %10s %13s\n' "case" "cpu median" "cpu p95" "cpu mean" "allocs/frame"
for ((round = 1; round <= ROUNDS; round++)); do
  for case in "${cases[@]}"; do
    IFS='|' read -r -a parts <<<"$case"
    name=${parts[0]}
    line=$("$SNAPSHOT" "$OUT/frame.png" "${parts[@]:1}" 2>&1 | grep '^measure' || true)
    median=$(sed -n 's/.*cpu median \([^,]*\),.*/\1/p' <<<"$line")
    p95=$(sed -n 's/.*cpu median [^,]*, p95 \([^,]*\),.*/\1/p' <<<"$line")
    mean=$(sed -n 's/.*cpu median [^|]*, mean \([^ ]*\) |.*/\1/p' <<<"$line")
    allocs=$(sed -n 's/.*allocs median \([0-9]*\),.*/\1/p' <<<"$line")
    printf '%-24s %10s %10s %10s %13s\n' "$name" "${median:-failed}" "${p95:-}" "${mean:-}" "${allocs:-}"
  done
done
uptime
